# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection (PostgreSQL for production, SQLite for local dev fallback)
# Local SQLite: sqlite:///instance/research_tracker.db
# PostgreSQL: postgresql://tracker_user:tracker_password@postgres:5432/research_tracker_db
DATABASE_URL=postgresql://tracker_user:tracker_password@postgres:5432/research_tracker_db

# Groq AI Service API Key
# Get key from https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Crossref API Contact Email (for polite API usage)
CROSSREF_EMAIL=researcher@example.com
